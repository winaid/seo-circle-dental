# 서치어드바이저에 등록한 주소와 글자 하나까지 같아야 합니다 (www 유무, https 까지).
SITE_URL=https://circle-dental-seo.vercel.app

# 네이버 서치어드바이저 > 사이트 등록 > HTML 태그 방식의 content 값
NAVER_SITE_VERIFICATION=
# 네이버 애널리틱스 (선택)
NAVER_ANALYTICS_ID=
# 구글 서치콘솔 HTML 태그 content 값 (선택)
GOOGLE_SITE_VERIFICATION=

# IndexNow 키 — 바꾸면 public/<키>.txt 파일도 같이 만들어야 합니다 (npm run indexnow 가 검사)
INDEXNOW_KEY=c1d2e0a7f3b94e6c8a5d1f0b7e2c9a4d

# 예약 발행: all 이면 전부 즉시 공개. 비우면 첫날 80편 + 하루 6편.
PUBLISH_MODE=
PUBLISH_FIRST_BATCH=80
PUBLISH_PER_DAY=6
